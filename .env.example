# frigate-layout-sync companion — configuration.
# Frigate's own nginx is the front door; this service only serves /__layoutsync/*.
# It edits Frigate's nginx (over the Docker socket) to inject the button and route
# /__layoutsync/* here, re-applying automatically whenever Frigate (re)starts.

# Name (or id) of your Frigate Docker container — used to exec `nginx` inside it.
FRIGATE_CONTAINER=frigate

# How Frigate's nginx should reach THIS companion (host:port on the shared Docker
# network). Defaults to the compose service name below. Must be resolvable by
# Frigate's nginx (put both on the same user-defined Docker network).
LAYOUTSYNC_UPSTREAM=frigate-layout-sync:3000

# Port this companion listens on (internal; Frigate's nginx proxies to it).
PORT=3000

# Where layouts.yaml is written (point it inside Frigate's /config to get backups).
DATA_DIR=./data

# Docker's embedded DNS, used by the injected nginx location to resolve the
# companion lazily (so the companion being down can't break Frigate's web UI).
NGINX_RESOLVER=127.0.0.11

# Path to Frigate's nginx.conf inside the container (rarely needs changing).
# FRIGATE_NGINX_CONF=/usr/local/nginx/conf/nginx.conf

# Set to false to manage Frigate's nginx yourself (bind-mount / manual snippet)
# instead of letting the companion edit it over the Docker socket.
# NGINX_AUTOCONFIG=false
